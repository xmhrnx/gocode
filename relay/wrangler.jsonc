{
  "name": "gocode-relay",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
